{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitType(chore)"],
  "ignoreDeps": [],
  "ignorePaths": ["**/node_modules/**"],
  "constraints": { "pnpm": "11.23.0" },
  "packageRules": [
    {
      "matchPackageNames": ["prisma", "@prisma/client"],
      "groupName": "prisma",
      "groupSlug": "prisma"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pnpm versions in Dockerfiles",
      "managerFilePatterns": ["/(^|/)[Dd]ockerfile[^/]*$/"],
      "matchStrings": ["pnpm@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    }
  ]
}
