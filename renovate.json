{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitType(chore)"],
  "ignoreDeps": [],
  "ignorePaths": ["**/node_modules/**"],
  "constraints": { "pnpm": "11.23.0" },
  "packageRules": [
    {
      "matchPackageNames": ["prisma", "@prisma/client"],
      "groupName": "prisma",
      "groupSlug": "prisma"
    }
  ]
}
